# Ambiente: API .dev na VPS (TEST_ENV=develop — nome histórico; branch Git é staging).
# Copiar para ".env.develop" e preencher.

BASE_URL=https://api.dev.crosshub.app.br

# Credenciais do tenant Libre usadas no preSetup (dashboard)
ADMIN_EMAIL=
ADMIN_PASSWORD=
TENANT_SLUG=auditoria
TENANT_NAME=Libre

# Senha das contas descartáveis do preSetup (mín. 12 caracteres)
POOL_PASSWORD=

TENANT_TIMEZONE=America/Sao_Paulo
LOG=false

# Opcional: POST /dashboard/test-fixtures/tenant (API com TEST_FIXTURES_ENABLED=true só em CI/local)
# TEST_FIXTURES_SECRET=

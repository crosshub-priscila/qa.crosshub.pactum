{
  "compilerOptions": {
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "target": "es2022",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "mocha"],
    "paths": {
      "@core/*": ["./core/src/*"],
      "@core/constants": ["./core/src/constants"],
      "@core/services/*": ["./core/src/services/*"],
      "@core/utils/*": ["./core/src/utils/*"],
      "@core/interfaces/*": ["./core/src/interface/*"],
      "@core/data/*": ["./core/src/data/*"],
      "@core/builders/*": ["./core/src/dataBuilder/*"],
      "@core/business/*": ["./core/src/business/*"],
      "@app/constants": ["./constants"],
      "@shared-data/*": ["./data/*"],
      "@preSetup/*": ["./preSetup/*"],

      "@analytics/*": ["./analytics/*"],
      "@analytics-data/*": ["./analytics/data/*"],
      "@analytics-tests/*": ["./analytics/tests/*"],

      "@appointments/*": ["./appointments/*"],
      "@appointments-data/*": ["./appointments/data/*"],
      "@appointments-tests/*": ["./appointments/tests/*"],


      "@auth/*": ["./auth/*"],
      "@auth-data/*": ["./auth/data/*"],
      "@auth-tests/*": ["./auth/tests/*"],

      "@banners/*": ["./banners/*"],
      "@banners-data/*": ["./banners/data/*"],
      "@banners-tests/*": ["./banners/tests/*"],

      "@branding/*": ["./branding/*"],
      "@branding-data/*": ["./branding/data/*"],
      "@branding-tests/*": ["./branding/tests/*"],

      "@catalog/*": ["./catalog/*"],
      "@catalog-data/*": ["./catalog/data/*"],
      "@catalog-tests/*": ["./catalog/tests/*"],

      "@dashboard/*": ["./dashboard/*"],
      "@dashboard-data/*": ["./dashboard/data/*"],
      "@dashboard-tests/*": ["./dashboard/tests/*"],

      "@forms/*": ["./forms/*"],
      "@forms-data/*": ["./forms/data/*"],
      "@forms-tests/*": ["./forms/tests/*"],

      "@groups/*": ["./groups/*"],
      "@groups-data/*": ["./groups/data/*"],
      "@groups-tests/*": ["./groups/tests/*"],

      "@people/*": ["./people/*"],
      "@people-data/*": ["./people/data/*"],
      "@people-tests/*": ["./people/tests/*"],

      "@privacy/*": ["./privacy/*"],
      "@privacy-data/*": ["./privacy/data/*"],
      "@privacy-tests/*": ["./privacy/tests/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
